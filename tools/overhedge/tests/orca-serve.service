[Unit]
Description=Orca runtime server (test container)
After=network-online.target
[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=HOME=/home/ubuntu
Environment=LIBGL_ALWAYS_SOFTWARE=1
ExecStart=/usr/bin/orca-ide serve --port 6768 --no-pairing --json
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
