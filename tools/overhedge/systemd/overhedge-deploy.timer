[Unit]
Description=Overhedge Orca fork: check for a pending deploy every 15 minutes

[Timer]
# Every 15 minutes; deploy-pending.sh exits at once without a pending build and applies the
# policy's window itself, so DEPLOY_POLICY alone decides when a deploy may happen.
OnCalendar=*:00/15
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
