[Unit]
Description=Overhedge Orca fork: port the newest upstream release and verify it (headless Claude)
Documentation=file:///home/ubuntu/overhedge-build/UPDATE-RUNBOOK.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/overhedge-build
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/overhedge-build/scripts/run-update.sh
# A port can take hours (wide test suites twice, two CI builds, smoke tests).
TimeoutStartSec=12h
Nice=5
